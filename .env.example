# Public browser values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only value. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
PROVIDER_KEY_ENCRYPTION_SECRET=
CRON_SECRET=
# Server-only Google service account JSON for Google Sheets online sync.
# Paste the complete JSON as a single Vercel environment-variable value.
GOOGLE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_APP_ENV=development
