rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == "admin"; }
    match /organizations/{orgId}/{document=**} {
      allow read: if signedIn() && request.auth.token.organizationId == orgId;
      allow write: if isAdmin() && request.auth.token.organizationId == orgId;
    }
    match /projects/{projectId}/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
